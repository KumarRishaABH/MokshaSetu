    <string name="detect_title">How we know</string>
    <string name="detect_subtitle">THE 3-CONFIDENCE CASCADE</string>
    <string name="detect_intro">We don\'t surveil for death — there\'s no bulk registry feed. We act in proportion to how sure we are.</string>
    <string name="detect_l1_title">1 · Suspicion</string>
    <string name="detect_l1_trigger">Inactivity · missed check-in</string>
    <string name="detect_l1_body">→ We ask the account holder first ("are you there?"). No condolences, nothing irreversible — it could just be a dead phone.</string>
    <string name="detect_l2_title">2 · Assertion</string>
    <string name="detect_l2_trigger">Nominee reports · insurer claim · bank flag</string>
    <string name="detect_l2_body">→ An accountable human says so → Tier-1 reversible protection begins (SIM no-recycle, fraud-watch) + gentle WhatsApp outreach.</string>
    <string name="detect_l3_title">3 · Proof</string>
    <string name="detect_l3_trigger">DigiLocker certificate + Aadhaar match</string>
    <string name="detect_l3_body">→ The state\'s own record — the only thing that unlocks anything irreversible (money, deletion), after a waiting period.</string>
    <string name="detect_begin_cta">This is how it begins →</string>

