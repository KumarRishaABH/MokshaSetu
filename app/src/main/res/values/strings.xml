    <string name="safety_title">The safety net</string>
    <string name="safety_subtitle">NO ONE GETS STRANDED</string>
    <string name="safety_intro">🛡️ No single human — and no algorithm — is ever a single point of failure. Redundancy covers the reachable cases; the law covers the rest.</string>
    <string name="safety_c1_title">📵 Nominee unreachable / lost phone</string>
    <string name="safety_c1_body">Social recovery — re-verify via Aadhaar. Compartment never lost.</string>
    <string name="safety_c2_title">🙅 Estranged / refuses to act</string>
    <string name="safety_c2_body">Backup nominee → then neutral escrow (law firm) + time-delay. Estate never frozen.</string>
    <string name="safety_c3_title">🕊️ Nominee already passed</string>
    <string name="safety_c3_body">Annual "legacy check-up" nudges re-assignment; backup covers the gap.</string>
    <string name="safety_c4_title">👥 ALL nominees gone / none named</string>
    <string name="safety_c4_body">Asset-map surfaced to legal heirs via a succession certificate through escrow. We never invent an heir.</string>
    <string name="safety_c5_title">⚖️ Family dispute</string>
    <string name="safety_c5_body">Contested asset frozen for irreversible actions; routed to succession. We orchestrate, never adjudicate.</string>
    <string name="safety_trustee_note">📌 Nominee = trustee, not owner. Every asset shows the legal heirs; funds are distributed per succession law.</string>
