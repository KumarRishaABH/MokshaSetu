    <!-- Safety net -->
    <string name="safety_title">The safety net</string>
    <string name="safety_subtitle">NO ONE GETS STRANDED</string>
    <string name="safety_intro">🛡️ No single human — and no algorithm — is ever a single point of failure. Redundancy covers the reachable cases; the law covers the rest.</string>
    <string name="safety_c1_title">📵 Nominee unreachable or lost phone</string>
    <string name="safety_c1_body">They re-verify with their own Aadhaar on any device. Nothing is tied to one handset.</string>
    <string name="safety_c2_title">🙅 Estranged nominee who refuses to act</string>
    <string name="safety_c2_body">Other nominees still claim their own assets independently. One person cannot freeze the estate.</string>
    <string name="safety_c3_title">🕊️ Nominee has also passed away</string>
    <string name="safety_c3_body">The asset falls back to succession law, and an annual legacy check-up nudges the planner to re-nominate.</string>
    <string name="safety_c4_title">👥 No nominee was ever named</string>
    <string name="safety_c4_body">The asset map is still surfaced to the legal heirs, so at least they know it exists. We never invent an heir.</string>
    <string name="safety_c5_title">⚖️ Family dispute</string>
    <string name="safety_c5_body">We stop at sending a verified claim. The institution and the courts decide. We orchestrate, never adjudicate.</string>
    <string name="safety_trustee_note">📌 Nominee = trustee, not owner. Funds are always distributed per succession law.</string>
